{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bastian-ibanez-portfolio",
  "compatibility_date": "2026-08-07",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "bastianibanez.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
